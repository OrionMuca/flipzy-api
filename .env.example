APP_NAME=Flipzy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flipzy
DB_USERNAME=flipzy
DB_PASSWORD=flipzy_password

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Cache & Session
CACHE_STORE=redis
CACHE_PREFIX=
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_FAILED_DATABASE=mysql
# Queue name for broadcast jobs (MessageSent, MessageRead); worker must process this queue
QUEUE_BROADCAST_QUEUE=broadcasts

# Broadcasting (real-time messages, etc.)
# Set to "reverb" (self-hosted), "pusher" (hosted), or "log"/"null" to disable
BROADCAST_CONNECTION=null
BROADCAST_DRIVER=${BROADCAST_CONNECTION}

# Laravel Reverb (self-hosted WebSocket server - recommended for real-time)
REVERB_APP_ID=flipzy
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# External APIs - ATTOM Data
ATTOM_API_KEY=
ATTOM_API_URL=https://api.gateway.attomdata.com/propertyapi/v1.0.0
ATTOM_RATE_LIMIT=60
ATTOM_RATE_LIMIT_HOUR=1000
ATTOM_TIMEOUT=30
ATTOM_MAX_RETRIES=3
ATTOM_BACKOFF=2
ATTOM_CACHE_TTL=7
ATTOM_CACHE_ENABLED=true
ATTOM_USE_ESTATED_FALLBACK=true

# External APIs - Estated (Fallback)
ESTATED_API_KEY=
ESTATED_API_URL=https://apis.estated.com

# External APIs - OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BASE_URL=
OPENAI_REQUEST_TIMEOUT=30

# External APIs - Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Pusher (real-time message broadcasting)
# Get these from: https://dashboard.pusher.com → your app → App Keys
# Then set BROADCAST_CONNECTION=pusher above
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Leave empty to use Pusher's default host (api-{cluster}.pusher.com)
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# External APIs - Geo Services
GEO_SERVICE=openstreetmap
MAPBOX_ACCESS_TOKEN=
GOOGLE_PLACES_API_KEY=

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Filesystem
FILESYSTEM_DISK=local
# Storage path for public disk (defaults to storage/app/public)
# For DigitalOcean volumes, set to: /mnt/volume_atl1_01/app/public
STORAGE_PATH=
# Storage volume path (for dedicated volume disk)
STORAGE_VOLUME_PATH=/mnt/volume_atl1_01/app/public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Passport
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
# Password grant (login/register). Run: php artisan passport:ensure-password-grant-client then copy ID and secret here.
# Stops "Password grant client secret not available" when cache is lost (e.g. container restart).
PASSPORT_PASSWORD_GRANT_CLIENT_ID=
PASSPORT_PASSWORD_GRANT_CLIENT_SECRET=

# Swagger/API Documentation
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=

# Horizon (queue worker - runs in Docker via Supervisor; run manually when not using Docker)
HORIZON_BALANCE=auto
HORIZON_MAX_PROCESSES=10
HORIZON_MEMORY=128
HORIZON_TRIES=3
HORIZON_TIMEOUT=90
# Optional: comma-separated queue names; leave empty for default set (includes broadcasts)
# HORIZON_QUEUES=default,broadcasts,emails-waiting-list,emails-auth,emails-admin
# To run only the broadcast queue: HORIZON_QUEUES=broadcasts

# Security
BCRYPT_ROUNDS=12
